# SILPHOR TECHNOLOGIES - Environment Configuration
# Automatically generated defaults are supplied safely. 
# Only external credentials (like Supabase or Razorpay Live Keys) need to be supplied manually.

PORT=3000

# =============================================================
# 1. CORE APPLICATION CONFIGURATION (Generated Safely by App)
# =============================================================
PROJECT=SILPHOR TECHNOLOGIES
WEBSITE_NAME=SILPHOR TECHNOLOGIES
WEBSITE_TAGLINE=DESIGN • INNOVATE • VERIFY • DELIVER
WEBSITE_CURRENCY=INR

# =============================================================
# 2. AUTHENTICATION (Automatically Generated 256-bit Random Secret)
# =============================================================
# If not provided, the application generates a cryptographically secure random secret automatically.
# Store as a server-side secret only.
JWT_SECRET=

# =============================================================
# 3. DATABASE CONFIGURATION (Single Source of Truth)
# =============================================================
# LOCAL DEVELOPMENT:
# When DATABASE_URL is empty, SQLite is automatically used at DATABASE_DIR=./data
DATABASE_DIR=./data

# PRODUCTION EXTERNAL POSTGRESQL (Supabase):
# When DATABASE_URL is provided, it serves as the single source of truth for production data.
# DATABASE_DIR and SQLite are not used when DATABASE_URL is active.
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# =============================================================
# 4. RAZORPAY INTEGRATION (Indian Rupee ₹ / INR)
# =============================================================
# Mode: "test" (default) or "live"
RAZORPAY_MODE=test

# Optional in initial development:
# If RAZORPAY_KEY_ID is missing, the application will NOT crash and will NOT generate fake keys.
# Test enrollments will proceed smoothly while displaying configuration status in the Admin Settings.
# When provided, real test or live Razorpay credentials are used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =============================================================
# 5. CAMPUS CONTACT & LOCATION (Bengaluru, Karnataka)
# =============================================================
CONTACT_PHONE=+91 7829455663
CONTACT_EMAIL=silphortechnologies@gmail.com
CONTACT_ADDRESS=#45 East Road, Malleswaram, Bangalore, Karnataka - 560003, India
CONTACT_LANDMARK=Near 8th Cross Cultural Hub & Malleswaram Ground
